{
  "generation": {
    "type": "json_schema",
    "json_schema": {
      "name": "steady_generation",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                },
                "reply": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "enum": [
                          "U0",
                          "U1",
                          "U2",
                          "U3",
                          "U4",
                          "U5",
                          "U6",
                          "U7"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "ref",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "reply",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "selected_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          }
        },
        "required": [
          "candidates",
          "selected_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "review": {
    "type": "json_schema",
    "json_schema": {
      "name": "steady_review",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "approved_ids": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
            }
          },
          "issues": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "irrelevant",
                    "unnecessary_question",
                    "repeated_template",
                    "premature_closing",
                    "unsupported_claim",
                    "boundary_violation",
                    "too_long",
                    "too_short",
                    "missed_risk",
                    "emoji"
                  ]
                }
              },
              "required": [
                "candidate_id",
                "code"
              ],
              "additionalProperties": false
            }
          },
          "repair_hint": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "approved_ids",
          "issues",
          "repair_hint"
        ],
        "additionalProperties": false
      }
    }
  }
}
